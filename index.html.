  const exact=await exactMateTree(positionFen,movesLeft,movesLeft===1?3000:9000);
  if(exact.ok&&exact.reply)return{u:exact.reply,exact:true};
  if(!exact.aborted)return null;
  // If the full tree is too large, fall back to Stockfish's strongest defense.
  const first=movesLeft<=1?1400:(movesLeft===2?2300:3200);
  let r=await sfRun(positionFen,first,20,1,'main');
  if(exactMateScore(r,movesLeft))return r;
  const second=movesLeft<=1?2600:(movesLeft===2?5200:7000);
  r=await sfRun(positionFen,second,20,1,'main');
  return exactMateScore(r,movesLeft)?r:null;
}
async function genOne(n,lvl,k,owner,onCandidate){
  const worker=await initSF(k);
  if(!worker)return null;
  const total=50;let engineFailures=0;
  for(let t=0;t<total;t++){
    if(owner&&cur!==owner)return undefined;
    let fen=null,probe=null;
    try{
      fen=t<35?midFen(lvl):endFen(lvl);
      if(!fen||USED_PUZZLES[owner.k].has(fen))continue;
      probe=new Chess(fen);
      if(!probe.moves().length)continue;
    }catch(e){continue}
    if(onCandidate)onCandidate(t+1,total,fen);
    let hasCheck=false;
    try{hasCheck=probe.moves().some(m=>m.includes('+'))}catch(e){continue}
    if(t<45&&!hasCheck)continue;
    // Give the engine enough time to find a real forced mate. A short first
    // search filters candidates; the longer confirmation prevents false puzzles.
    const first=await sfRun(fen,n===2?900:1500,20,1,k);
    if(owner&&cur!==owner)return undefined;
    if(!first){engineFailures++;if(engineFailures>=3){SF[k].error=SF[k].error||'Stockfish-ის ძრავამ პასუხი შეწყვიტა';return null;}continue;}
    engineFailures=0;
    if(!first.sc||first.sc.t!=='mate'||first.sc.v!==n)continue;
    const confirm=await sfRun(fen,n===2?2200:4200,20,1,k);
    if(owner&&cur!==owner)return undefined;
    if(!confirm){engineFailures++;if(engineFailures>=3){SF[k].error=SF[k].error||'Stockfish-ის ძრავამ პასუხი შეწყვიტა';return null;}continue;}
    engineFailures=0;
    if(confirm.sc&&confirm.sc.t==='mate'&&confirm.sc.v===n&&confirm.u&&confirm.u!=='(none)'){
      // Do not publish an engine-only guess: verify the entire legal move tree.
      const proof=await exactMateTree(fen,n,n===2?2200:4200);
      if(owner&&cur!==owner)return undefined;
      if(proof.ok){
        USED_PUZZLES[owner.k].add(fen);
        return fen;
      }
    }
  }
  // undefined means this batch had no puzzle; null means Stockfish failed to load.
  return undefined;
}
async function newPuzzle(){
  const k=catKey,n=CATS[k].gen,lvl=Math.floor(P.lv[k]);
  const me=cur={kind:'puz',n,k,left:n,helped:0,busy:false,rev:null,side:'w',done:false,fen:null};
  const pz=pickPuz('m'+n,lvl);me.fen=pz.fen;game=new Chess(me.fen);const TH={e:'მარტივი მატი',b:'უკანა რიგის მატი',s:'smothered მატი',r:'არაბული მატი',a:'ანასტასიას მატი',p:'მატი პაიკის გადაქცევით',k:'დედოფლისა და მეფის მატი',i:'ოფიცრით მატი',n:'ცხენით მატი',o:'ბოდენის მატი',e:'ეპოლეტის მატი',d:'დამიანოს მატი',t:'ტაქტიკური მატი'}[pz.tag];last=null;sel=null;flip=false;$('vars').innerHTML='';$('board').style.opacity=1;boardNotice('');
  $('ltitle').textContent='მატი '+n+' სვლაში';
  setMsg('თეთრი თამაშობს და აძლევს მატს '+n+' სვლაში. გაქვს '+n+' სვლა, ნებისმიერი სვლა შეგიძლია გააკეთო. თუ ვერ მოახერხე, ამოცანა თავიდან დაიწყება. თემა: '+TH+'.');refresh();
}
function whiteMates(g,left,c){
  for(const m of g.moves()){
    if(++c.n>c.max)throw 0;
    g.move(m);let ok=false;
    if(g.in_checkmate())ok=true;
    else if(left>1&&!g.game_over()){ok=true;for(const r of g.moves()){g.move(r);const w=whiteMates(g,left-1,c);g.undo();if(!w){ok=false;break}}}
    g.undo();if(ok)return m}
  return null}
function pickDefense(g,left){
  const all=g.moves(),safe=[];
  for(const r of all){g.move(r);let mt=null;try{mt=whiteMates(g,left,{n:0,max:12000})}catch(e){}g.undo();if(!mt)safe.push(r)}
  const pool=safe.length?safe:all;return pool[Math.floor(Math.random()*pool.length)]}
function restartPuz(me){if(cur!==me)return;game=new Chess(me.fen);last=null;sel=null;me.left=me.n;me.help=null;me.busy=false;me.helped=0;refresh()}
async function puzMove(from,to,dragged){
  const me=cur;
  if(!me||me.busy||me.done)return render();
  const choices=game.moves({verbose:true}).filter(x=>x.from===from&&x.to===to);
  if(!choices.length)return render();
  sel=null;me.busy=true;me.help=null;
  last=game.move({from,to,promotion:choices[0].promotion||'q'});anim=!dragged;me.left--;
  if(game.in_checkmate()){
    me.done=true;
    P.lv[me.k]=me.helped?Math.max(1,P.lv[me.k]-.5):Math.min(12,P.lv[me.k]+1);logAct(me.k,CATS[me.k].n);save();
    setMsg('მატი! ✓ '+(me.helped?'დახმარება გამოიყენე. ':'შესანიშნავია! ')+'შემდეგი ამოცანა იწყება…');refresh();
    setTimeout(()=>{if(cur===me)newPuzzle()},1600);return}
  refresh();
  if(me.left<=0||game.game_over()){
    shake();setMsg('მატი ვერ მოხერხდა '+me.n+' სვლაში. ამოცანა თავიდან იწყება…');
    setTimeout(()=>restartPuz(me),1500);return}
  setMsg('შავი ფიქრობს…');
  setTimeout(()=>{
    if(cur!==me)return;
    const r=pickDefense(game,me.left);
    last=game.move(r);anim=true;me.busy=false;
    setMsg('დარჩა '+me.left+' სვლა მატისთვის.');refresh()},350);
}
