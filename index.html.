<!DOCTYPE html>
<html lang="ka">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Chess Openings</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#e9eef3;--ink:#1d2b3a;--panel:#fff;--light:#d6e0ea;--dark:#5f7f9f;--hl:#f2b01e;--best:#2e9d6a;--mute:#5d6b7a}
@media(prefers-color-scheme:dark){:root{--bg:#18222d;--ink:#e6edf4;--panel:#223140;--mute:#9fb0c1}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Noto Sans Georgian',system-ui,sans-serif;line-height:1.6}
header{padding:18px 20px 6px;max-width:1000px;margin:auto}
h1{margin:0;font-size:1.6rem;font-weight:800}
header p{margin:4px 0 0;color:var(--mute)}
.row{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
main{display:flex;flex-wrap:wrap;gap:20px;max-width:1000px;margin:auto;padding:14px 20px 40px}
.boardwrap{flex:1 1 380px;max-width:520px}
.bw{position:relative;width:100%;max-width:520px}
#board{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));grid-template-rows:repeat(8,minmax(0,1fr));width:100%;height:auto;aspect-ratio:1/1;min-width:0;min-height:0;border-radius:6px;overflow:hidden;user-select:none;touch-action:none;container-type:inline-size}
#arr{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
#boardNotice{position:absolute;inset:0;z-index:8;display:flex;align-items:center;justify-content:center;padding:20px;text-align:center;background:rgba(20,30,40,.28);color:#fff;font-weight:800;text-shadow:0 1px 3px #000;pointer-events:none}
#boardNotice[hidden]{display:none!important}
#boardNotice.error{background:rgba(120,35,35,.42)}
#boardNotice span{background:rgba(20,30,40,.82);padding:12px 16px;border-radius:9px;max-width:90%}
.sq{display:flex;align-items:center;justify-content:center;font-size:9.5cqw;line-height:1;cursor:pointer;position:relative;min-width:0;min-height:0}
.sq.l{background:var(--light)}.sq.d{background:var(--dark)}
.sq.last::before,.sq.hint::before{content:'';position:absolute;inset:0;background:rgba(242,176,30,.5)}
.sq.hint::before{background:rgba(242,176,30,.7)}
.sq.sel::before{content:'';position:absolute;inset:0;background:rgba(242,176,30,.65)}
.sq.tgt::after{content:'';position:absolute;width:28%;height:28%;border-radius:50%;background:rgba(29,43,58,.35)}
.p{display:flex;align-items:center;justify-content:center;width:100%;height:100%;position:relative;z-index:1}
.w{color:#fff;text-shadow:0 0 2px #000,0 0 2px #000,0 0 2px #000}
.b{color:#111;text-shadow:0 0 1px #fff}
.p.slide{animation:slide .38s cubic-bezier(.3,.8,.3,1);z-index:5}
@keyframes slide{from{transform:translate(calc(var(--dx)*100%),calc(var(--dy)*100%))}to{transform:none}}
.shake{animation:shake .35s}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
#ghost{position:fixed;pointer-events:none;z-index:99;display:flex;align-items:center;justify-content:center;transform:translate(-50%,-50%) scale(1.15)}
.ctrl{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
button{font:inherit;border:0;border-radius:6px;padding:9px 14px;background:var(--panel);color:var(--ink);cursor:pointer;font-weight:600;box-shadow:0 1px 0 rgba(0,0,0,.2)}
button:hover{background:var(--hl);color:#111}
button:focus-visible{outline:3px solid var(--hl);outline-offset:2px}
button.main{background:var(--best);color:#fff}
.side{flex:1 1 320px}
.card{background:var(--panel);border-radius:8px;padding:16px;margin-bottom:14px}
.card h2{margin:0 0 6px;font-size:1.1rem}
#lessons{display:flex;flex-direction:column;gap:6px}
#lessons button{text-align:left;width:100%}
#lessons button.on{background:var(--ink);color:var(--bg)}
#comment{min-height:70px}
#eval,#lvl{color:var(--mute);margin:8px 0 0;min-height:1.4em}
#moves{display:flex;flex-wrap:wrap;gap:4px;margin-top:6px}
.mvb{padding:3px 8px;font-size:.9rem;font-weight:400}.mvb.on{background:var(--hl);color:#111}
.view{animation:fade .4s ease}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
#menu{max-width:1000px;margin:auto;padding:10px 20px 40px;display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}
.cat{background:var(--panel);border-radius:10px;padding:18px;text-align:left;display:block;width:100%;transition:transform .2s,box-shadow .2s}
.cat:hover{transform:translateY(-4px);box-shadow:0 8px 18px rgba(0,0,0,.18);background:var(--panel);color:var(--ink)}
.cat b{display:block;font-size:1.05rem}.cat span{color:var(--mute);font-weight:400;font-size:.9rem}
select{font:inherit;padding:8px;border-radius:6px;border:0}
.vb{padding:4px 10px;font-size:.85rem;font-weight:400}.vb.on{background:var(--hl);color:#111}
[hidden]{display:none!important}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<header>
  <h1>Chess Openings</h1>
  <p id="sub"></p>
  <div class="row"><button id="back" hidden>← მენიუ</button><button id="prof"></button><button id="exp">პროგრესის კოდი</button><button id="imp">კოდის ჩატვირთვა</button></div>
</header>
<section id="menu" class="view"></section>
<main id="study" hidden>
  <div class="boardwrap">
    <div class="bw"><div id="board"></div>
      <svg id="arr" viewBox="0 0 8 8"><defs><marker id="ah" markerWidth="3" markerHeight="3" refX="1.5" refY="1.5" orient="auto"><path d="M0,0 L3,1.5 L0,3z" fill="#f2b01e"/></marker></defs><line id="al" stroke="#f2b01e" stroke-width=".17" stroke-linecap="round" marker-end="url(#ah)" opacity=".9" hidden/></svg>
      <div id="boardNotice" hidden><span></span></div>
    </div>
    <div class="ctrl">
      <button id="prev">◀</button><button id="next">▶</button>
      <button id="help" class="main">დახმარება</button>
      <button id="mode"></button>
      <button id="arrows" aria-pressed="true">ისრები: ჩართული</button>
      <button id="flip">გადაბრუნება</button>
      <button id="reset">თავიდან</button>
      <select id="engsel" hidden></select>
      <button id="np" class="main">შემდეგი ამოცანა</button>
    </div>
    <p id="lvl"></p><p id="eval" aria-live="polite"></p>
  </div>
  <div class="side">
    <div class="card"><h2 id="lhead"></h2><div id="lessons"></div><div id="vars" class="row"></div></div>
    <div class="card"><h2 id="ltitle"></h2><div id="comment"></div><div id="moves"></div></div>
  </div>
</main>
<div id="ghost" hidden></div>
