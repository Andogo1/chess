  }
  function boot(){
    if (typeof window.Chess !== 'function') { loadNext(); return; }
    const source = document.getElementById('app-code');
    if (!source) { showLoadError(); return; }
    const runner = document.createElement('script');
    runner.textContent = source.textContent;
    document.body.appendChild(runner);
  }
  function loadNext(){
    if (index >= sources.length) { showLoadError(); return; }
    const script = document.createElement('script');
    script.src = sources[index++];
    script.async = true;
    script.onload = boot;
    script.onerror = loadNext;
    document.head.appendChild(script);
  }
  loadNext();
})();
